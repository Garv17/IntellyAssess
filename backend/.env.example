# Copy to .env and adjust. Never commit the real .env.
ENVIRONMENT=development
DEBUG=true

# Logging. LOG_FORMAT=json emits one JSON object per line for a log shipper;
# LOG_FORMAT=console is the readable form for a local terminal. LOG_SQL is
# separate from LOG_LEVEL because SQLAlchemy echo at INFO buries everything else.
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_SQL=false

DATABASE_URL=postgresql+asyncpg://exam:exam@localhost:5432/exam
DATABASE_URL_SYNC=postgresql+psycopg://exam:exam@localhost:5432/exam
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Brevo transactional email (student magic-link login). Get the API key from
# Brevo > SMTP & API > API Keys. BREVO_SENDER_EMAIL must be a verified sender
# in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=IntellyAssess
FRONTEND_BASE_URL=http://localhost:5180
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_COOLDOWN_SECONDS=60

AUTOSAVE_FLUSH_SECONDS=15
AUTOSUBMIT_SWEEP_SECONDS=30
HEARTBEAT_SECONDS=30

SUBMISSION_MAX_CODE_BYTES=65536

AI_EVALUATION_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60

OPENAI_MAX_OUTPUT_TOKENS=1500
# Marking scheme and evaluator prompt. Relative paths resolve from backend/.
CODING_RUBRIC_PATH=assessments/rubrics/default_coding.yaml
CODING_EVALUATOR_PROMPT_PATH=ai/prompts/coding_evaluator.md
# Below this confidence, the review screen shows "Manual Review Recommended".
AI_LOW_CONFIDENCE_THRESHOLD=0.6

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

CORS_ORIGINS=["http://localhost:5180"]

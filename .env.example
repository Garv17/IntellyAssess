# Copy to .env and adjust. Never commit the real .env.
# Read by `docker compose` itself (not the backend) to fill in docker-compose.yml.

POSTGRES_USER=exam
POSTGRES_PASSWORD=exam
POSTGRES_DB=exam

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# Judge worker concurrency — conservative defaults for a 4-vCPU box (2+1 sandbox
# containers at JUDGE_CPUS=1.0 each, leaving ~1 core for postgres/redis/backend).
# Raise these on a bigger box, or run judge_run/judge_grade on a dedicated host
# pointed at this host's Redis/Postgres instead of raising them past what this
# box's core count supports — see SCALING.md.
JUDGE_RUN_CONCURRENCY=2
JUDGE_GRADE_CONCURRENCY=1
JUDGE_CPUS=1.0
JUDGE_MEMORY_MB=256
JUDGE_PIDS_LIMIT=64
JUDGE_COMPILE_TIMEOUT_SECONDS=20

# Per-attempt Run rate limit (Redis-backed, see app/cache.py claim_run_cooldown).
RUN_RATE_LIMIT_SECONDS=20

# Warm container pool (app/services/judge_pool.py). Ships disabled — reusing a
# container across different students' code is only as safe as the leak test in
# SCALING.md proves it is against your actual Docker daemon/images. Flip on only
# after running that test.
JUDGE_POOL_ENABLED=false
JUDGE_POOL_SIZE_PER_LANGUAGE=3
JUDGE_POOL_MEMORY_MB=512
JUDGE_POOL_SLOT_TTL_SECONDS=240

# Resource caps on the non-judge services, so a judge burst can't starve them.
# These defaults assume a 4-vCPU box. Check `nproc` on your actual host and raise
# them proportionally — left unchanged on a bigger machine, they throttle the API
# below what the host could give it (SCALING.md §5 measured this: on an 8-core
# box, BACKEND_CPU_LIMIT=1.5 alone was enough to fail 105 of 120 simultaneous
# logins before judge load was ever involved).
POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEM_LIMIT=1024m
REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=640m
BACKEND_CPU_LIMIT=1.5
BACKEND_MEM_LIMIT=1024m
